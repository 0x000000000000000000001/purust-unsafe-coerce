#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

CLEAN=0
for arg in "$@"; do
  case "$arg" in
    -c|--clean) CLEAN=1 ;;
    *) echo "Usage: bin/test [-c|--clean]" >&2; exit 2 ;;
  esac
done

COMPILER_DIR="$(cd ../purust && pwd)"
SPAGO_BIN="$COMPILER_DIR/node_modules/.bin/spago"
if [ ! -x "$SPAGO_BIN" ]; then
  printf 'Missing Spago dependency. Run npm install in %s.\n' "$COMPILER_DIR" >&2
  exit 1
fi
# Prefer the sibling TAST fork; PURS can select another build explicitly.
if [ -n "${PURS:-}" ]; then
  PURS_BIN="$(command -v "$PURS")"
else
  FORK_BUILDS=("$COMPILER_DIR"/../../purescript/.stack-work/dist/*/*/build/purs/purs)
  if [ "${#FORK_BUILDS[@]}" = 1 ] && [ -x "${FORK_BUILDS[0]}" ]; then
    PURS_BIN="${FORK_BUILDS[0]}"
  else
    PURS_BIN="$(command -v purs)"
  fi
fi
export PATH="$(dirname "$PURS_BIN"):$COMPILER_DIR/node_modules/.bin:$PATH"
if [ "$CLEAN" = 1 ]; then
  echo "=== Recompiling purust ==="
  # Run Spago directly with the TAST-enabled compiler first on PATH. `npm run
  # build` would inject ancestor `node_modules/.bin` directories, and an old
  # PureScript at the workspace root (or the missing local fork download)
  # would otherwise win.
  (cd "$COMPILER_DIR" && "$SPAGO_BIN" build \
    && "$SPAGO_BIN" bundle --module Main --platform node --outfile bin/purust.js --bundle-type app)
fi

# Clean this package only. Always regenerate its TAST and Rust output.
rm -rf output
if [ "$CLEAN" = 1 ]; then
  rm -rf .spago .cache
fi

echo "=== Building TAST and generating Rust with spago ==="
"$SPAGO_BIN" build
node -e 'const fs = require("node:fs"); const m = JSON.parse(fs.readFileSync("output/Test.Main/corefn.json", "utf8")); if (!Array.isArray(m.dataDecls)) { console.error("A TAST-enabled PureScript fork is required; set PURS to its executable."); process.exit(1); }'

echo "=== Compiling Rust FFI and tests ==="
cargo build --manifest-path output/purust_output/Cargo.toml

echo "=== Running package integration tests ==="
node --input-type=module <<'NODE'
import { spawnSync } from 'node:child_process';
import { readFileSync, writeFileSync } from 'node:fs';
const binary = 'output/purust_output/target/debug/purust_output';
const run = (scenario) => {
  const result = spawnSync(binary, [String(scenario)], { encoding: 'utf8', timeout: 10000 });
  writeFileSync(`output/scenario-${scenario}.stdout`, result.stdout ?? '');
  writeFileSync(`output/scenario-${scenario}.stderr`, result.stderr ?? '');
  if (result.error || result.signal) throw new Error(`scenario ${scenario}: ${result.error ?? result.signal}`);
  return result;
};
const positive = run(0);
process.stdout.write(positive.stdout);
if (positive.status !== 0 || positive.stderr !== '' || positive.stdout !== readFileSync('test/expected.stdout', 'utf8')) {
  process.stderr.write(positive.stderr);
  throw new Error('positive suite failed or produced unexpected output');
}
const failures = JSON.parse(readFileSync('test/failures.json', 'utf8'));
for (const [scenario, message] of Object.entries(failures)) {
  const result = run(scenario);
  if (result.status !== 101 || result.stdout.includes('UNREACHABLE') || !result.stderr.includes(message)) {
    process.stderr.write(result.stderr);
    throw new Error(`scenario ${scenario}: expected panic exit 101 containing ${JSON.stringify(message)}, got ${result.status}`);
  }
  console.log(`[OK] expected process failure ${scenario}`);
}
console.log('Summary: original fixtures, integration assertions and expected process failures passed.');
NODE
